# Production Secret Template
# Copy this file to secret-patch.yaml and fill in your actual values
# NEVER commit the actual secret-patch.yaml to version control!

apiVersion: v1
kind: Secret
metadata:
  name: telepaygate-secret
type: Opaque
stringData:
  # Database Credentials - UPDATE THESE!
  POSTGRES_USER: "your_production_db_user"
  POSTGRES_PASSWORD: "your_secure_db_password_here"
  POSTGRES_DB: "telepaygate_prod"
  DATABASE_URL: "postgresql://your_production_db_user:your_secure_db_password_here@db:5432/telepaygate_prod"
  
  # Telegram Bot Configuration - UPDATE THESE!
  TELEGRAM_BOT_TOKEN: "123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
  TELEGRAM_WEBHOOK_SECRET: "your_telegram_webhook_secret_here"
  TELEGRAM_WEBHOOK_URL: "https://api.yourdomain.com/api/webhooks/telegram"
  
  # TON Blockchain Configuration - UPDATE THESE!
  TON_API_KEY: "your_ton_api_key_here"
  TON_WALLET_MNEMONIC: "word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"
  PLATFORM_TON_WALLET: "EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  TON_MASTER_WALLET_ADDRESS: "EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  
  # Exchange Rate Providers - UPDATE THESE!
  COINGECKO_API_KEY: "your_coingecko_api_key_here"
  COINMARKETCAP_API_KEY: "your_coinmarketcap_api_key_here"
  CMC_API_KEY: "your_coinmarketcap_api_key_here"
  
  # Fiat Settlement Connectors - UPDATE THESE!
  KRAKEN_API_KEY: "your_kraken_api_key"
  KRAKEN_API_SECRET: "your_kraken_api_secret"
  COINLIST_API_KEY: "your_coinlist_api_key"
  COINLIST_API_SECRET: "your_coinlist_api_secret"
  STRIPE_SECRET_KEY: "sk_live_..."
  WISE_API_KEY: "your_wise_api_key_here"
  
  # Security / Secrets - GENERATE SECURE VALUES!
  # Generate with: openssl rand -base64 32
  API_SECRET_KEY: "your_api_secret_key_minimum_32_characters_here"
  # Generate with: openssl rand -base64 32
  JWT_SECRET: "your_jwt_secret_minimum_32_characters_here"
  # Generate with: openssl rand -base64 32
  WEBHOOK_SECRET: "your_webhook_secret_minimum_32_characters_here"
  # Generate with: openssl rand -hex 32
  WALLET_ENCRYPTION_KEY: "your_encryption_key_minimum_64_characters_here"
  
  # CAPTCHA Configuration - UPDATE THESE!
  CAPTCHA_SECRET: "your_captcha_secret_here"
  
  # Email / SMTP Configuration - UPDATE THESE!
  EMAIL_SMTP_USER: "your_smtp_username"
  EMAIL_SMTP_PASS: "your_smtp_password"
  
  # AWS KMS Configuration - UPDATE THESE!
  AWS_KMS_KEY_ID: "your_aws_kms_key_id_here"
  
  # Trigger.dev Configuration - UPDATE THESE!
  TRIGGER_SECRET_KEY: "your_trigger_secret_key_here"
  
  # Render.com Deployment - UPDATE THESE!
  RENDER_API_KEY: "your_render_api_key_here"
  RENDER_API_SERVICE_ID: "srv_xxxxxxxxxxxxxxxxxx"
  RENDER_WORKER_SERVICE_IDS: "srv_worker1,srv_worker2"
  
  # NitroSwaps Configuration - UPDATE THESE!
  NITRO_API_KEY: "your_nitro_api_key_here"
