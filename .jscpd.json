{
  "reporters": ["json"],
  "output": "jscpd-report.json",
  "path": "./",
  "ignore": [
    "**/node_modules/**",
    "**/coverage/**",
    "**/dist/**",
    "**/docs/**",
    "**/*.min.js",
    "**/*.bundle.js"
  ],
  "threshold": 3,
  "minLines": 5
}
{
  "paths": ["packages", "src"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.min.js",
    "docs/reports/**"
  ],
  "minLines": 5,
  "reporters": ["json"]
}
