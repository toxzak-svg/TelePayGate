{
  "name": "telepaygate",
  "version": "0.1.0",
  "description": "Unified payment processing for Telegram Stars → TON → Fiat conversions",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w telepaygate-core && npm run build -w telepaygate-api && npm run build -w @tg-payment/dashboard && npm run build -w telepaygate-sdk",
    "build:backend": "npm run build -w telepaygate-core && npm run build -w telepaygate-api",
    "test": "npm run test:prepare && npm run test:run",
    "test:run": "dotenv -e .env.test -- npm run test --workspaces --if-present",
    "test:prepare": "if [ -z \"$DATABASE_URL\" ]; then PGPASSWORD=tg_pass createdb -U tg_user -h localhost -p 5432 tg_payment_test || true; DATABASE_URL=postgresql://tg_user:tg_pass@localhost:5432/tg_payment_test node database/migrate.cjs reset; else node database/migrate.cjs reset; fi",
    "dev": "npm run dev --workspaces --if-present",
    "test:detect": "dotenv -e .env.test -- jest --detectOpenHandles --runInBand --forceExit",
    "dev:all": "npm run docker:up && cd packages/dashboard && npm run dev",
    "dev:local": "DASHBOARD_LOCAL=true bash scripts/dev-up.sh",
    "clean": "bash ./scripts/clean.sh",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "worker:fees": "npm run worker:fees -w telepaygate-core",
    "wallet:update": "node packages/core/scripts/update-platform-wallet.js",
    "migrate": "node database/migrate.cjs up",
    "migrate:status": "node database/migrate.cjs status",
    "migrate:reset": "node database/migrate.cjs reset",
    "db:setup": "npm run migrate",
    "docker:build": "docker build -t tg-payment-gateway .",
    "generate:secrets": "bash scripts/generate-local-env.sh",
    "docker:up": "docker-compose up -d",
    "docker:migrate": "docker-compose run --rm migrations",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "trigger:dev": "npx trigger.dev@latest dev",
    "trigger:deploy": "npx trigger.dev@latest deploy",
    "prepare": "bash scripts/install-git-hooks.sh || true",
    "test:ci": "npm run -w telepaygate-core test -- --detectOpenHandles && npm run -w telepaygate-api test -- --detectOpenHandles && npm run -w telepaygate-sdk test -- --detectOpenHandles && npm run -w @tg-payment/dashboard test",
    "coverage:telepaygate-sdk": "npm run -w telepaygate-sdk test:coverage",
    "coverage:dashboard": "npm run -w @tg-payment/dashboard test -- --coverage",
    "coverage:core": "npm run -w telepaygate-core test:coverage",
    "coverage:api": "npm run -w telepaygate-api test -- --coverage",
    "coverage:all": "npm run coverage:telepaygate-sdk && npm run coverage:dashboard && npm run coverage:core && npm run coverage:api",
    "coverage:merge": "npx lcov-result-merger './packages/**/coverage/lcov.info' > coverage/lcov.info || true"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@trigger.dev/build": "^4.1.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/pg-promise": "^0.0.28",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "autoprefixer": "^10.4.22",
    "axios": "^1.13.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.53.0",
    "lcov-result-merger": "^3.0.1",
    "normalize-range": "^0.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.0.3",
    "sharp": "^0.32.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.17",
    "testcontainers": "^11.11.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.0.0",
    "@trigger.dev/sdk": "^4.1.1",
    "dotenv": "^17.2.3",
    "pg": "^8.11.3",
    "pg-promise": "^12.2.0",
    "tonweb": "^0.0.66"
  },
  "optionalDependencies": {
    "@aws-sdk/client-kms": "^3.382.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
