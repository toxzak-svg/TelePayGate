{
  "name": "telepaygate-sdk",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript SDK for TelePayGate - Telegram Stars to TON/Fiat payment gateway",
  "author": "TelePayGate Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toxzak-svg/TelePayGate.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/toxzak-svg/TelePayGate/issues"
  },
  "homepage": "https://github.com/toxzak-svg/TelePayGate/tree/main/packages/sdk#readme",
  "keywords": [
    "telegram",
    "telegram-stars",
    "ton",
    "toncoin",
    "payment",
    "payment-gateway",
    "crypto",
    "sdk",
    "client",
    "api-client",
    "typescript",
    "javascript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && tsc --build --force && rm -rf dist/__tests__",
    "dev": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  }
}
