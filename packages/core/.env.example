# ==============================================================================
# TELEPAYGATE CORE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# 
# This file contains environment variables specific to the Core package.
# The Core package loads environment variables from the project root .env file.
# Copy this file to `.env` at the project root and fill in real values.
#
# SECURITY REQUIREMENTS:
# - NEVER commit actual .env files with real credentials to version control
# - Use strong, unique secrets for all sensitive values
# - Rotate secrets regularly in production environments
# - Use different values for development, staging, and production
#
# GENERATING SECURE VALUES:
# - JWT_SECRET: openssl rand -base64 32 (min 32 characters required)
# - WALLET_ENCRYPTION_KEY: openssl rand -hex 32 (min 64 characters required)
# - API_SECRET_KEY: openssl rand -base64 32
# - WEBHOOK_SECRET: openssl rand -base64 32
#
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER / RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Node.js environment (development, test, production)
NODE_ENV=development

# Server port for core services
PORT=3000

# Public API URL (used for webhooks, callbacks, and CORS)
API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://tg_user:your_database_password_here@localhost:5432/telepaygate_dev

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Database connection timeouts (milliseconds)
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Database SSL configuration
# For production, SSL is enabled automatically. For local development with
# self-signed certificates, set DB_SSL_ALLOW_UNAUTHORIZED=true (NOT RECOMMENDED)
DB_SSL_ALLOW_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# REDIS CACHE / QUEUE
# ------------------------------------------------------------------------------
# Redis connection URL (optional, for caching and job queues)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# TELEGRAM BOT CONFIGURATION
# ------------------------------------------------------------------------------
# Telegram Bot API token (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram webhook secret for verifying incoming webhooks
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Telegram webhook URL (auto-registered if set)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/webhooks/telegram

# Telegram Stars provider token (for Telegram Stars payments)
TELEGRAM_PROVIDER_TOKEN=STARS

# ------------------------------------------------------------------------------
# TON BLOCKCHAIN CONFIGURATION
# ------------------------------------------------------------------------------
# TON Center API key (optional, for higher rate limits)
# Get from https://toncenter.com/
TON_API_KEY=your_ton_api_key_here

# TON API endpoint URL
# Mainnet: https://toncenter.com/api/v2/jsonRPC
# Testnet: https://testnet.toncenter.com/api/v2/jsonRPC
TON_API_URL=https://toncenter.com/api/v2/jsonRPC

# Alternative TON API endpoint (used by docker-compose)
TON_API_ENDPOINT=https://tonx.space/api

# Network selection (true for mainnet, false for testnet)
TON_MAINNET=false

# TON workchain ID (usually 0)
TON_WORKCHAIN=0

# TON wallet mnemonic (24 words, space-separated)
# SECURITY: NEVER commit real mnemonics to version control
# Generate with: https://ton.org/wallets
TON_WALLET_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"

# Minimum number of blockchain confirmations required (default: 2)
TON_MIN_CONFIRMATIONS=2

# Platform wallet address for fee collection (EQ... or UQ...)
PLATFORM_TON_WALLET=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative: Master wallet address for fee collection
TON_MASTER_WALLET_ADDRESS=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# SECURITY / SECRETS
# ------------------------------------------------------------------------------
# API secret key for internal operations
# Generate with: openssl rand -base64 32
API_SECRET_KEY=your_api_secret_key_minimum_32_characters_here

# JWT signing secret
# CRITICAL: MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# Webhook secret for signature verification
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET=your_webhook_secret_minimum_32_characters_here

# Wallet encryption key for encrypting stored mnemonics
# CRITICAL: MUST be at least 64 characters (32 bytes hex)
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=your_encryption_key_minimum_64_characters_here

# ------------------------------------------------------------------------------
# P2P DEX INTEGRATION
# ------------------------------------------------------------------------------
# DeDust API URL
DEDUST_API_URL=https://api.dedust.io

# Ston.fi API URL
STONFI_API_URL=https://api.ston.fi

# DEX slippage tolerance percentage (default: 0.5)
DEX_SLIPPAGE_TOLERANCE=0.5

# DEX simulation mode (true for testing without real transactions)
DEX_SIMULATION_MODE=true

# Enable real DEX integration tests
RUN_DEX_INTEGRATION_TESTS=false

# DeDust test pool ID (for testing)
DEDUST_TEST_POOL_ID=EQD_test_pool

# ------------------------------------------------------------------------------
# NITROSWAPS INTEGRATION
# ------------------------------------------------------------------------------
# Enable NitroSwaps feature
NITRO_FEATURE_ENABLED=false

# NitroSwaps API base URL
NITRO_API_URL=https://api.nitro.com

# NitroSwaps API key
NITRO_API_KEY=your_nitro_api_key_here

# ------------------------------------------------------------------------------
# CONVERSION SETTINGS
# ------------------------------------------------------------------------------
# Minimum Telegram Stars amount for conversion
MIN_CONVERSION_STARS=100

# Rate lock duration in seconds (how long exchange rates are guaranteed)
RATE_LOCK_DURATION_SECONDS=300

# Maximum pending conversions allowed
MAX_PENDING_CONVERSIONS=10

# P2P pool refresh interval in seconds
P2P_POOL_REFRESH_INTERVAL=30

# ------------------------------------------------------------------------------
# EXCHANGE RATE PROVIDERS
# ------------------------------------------------------------------------------
# CoinGecko API key (optional, for rate fetching)
# Get from https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_api_key_here

# CoinMarketCap API key (optional, for rate fetching)
# Get from https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Alternative: CMC API key alias
CMC_API_KEY=your_coinmarketcap_api_key_here

# Rate simulation mode (true for testing without real API calls)
RATE_SIMULATION_MODE=false

# DexScreener API URL
DEXSCREENER_API_URL=https://api.dexscreener.com/latest/dex/tokens

# ------------------------------------------------------------------------------
# FIAT SETTLEMENT CONNECTORS (Optional)
# ------------------------------------------------------------------------------
# Fiat gateway provider (stub, stripe, wise)
FIAT_GATEWAY_PROVIDER=stub

# Kraken API credentials (optional)
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# Coinlist API credentials (optional)
COINLIST_API_KEY=your_coinlist_api_key
COINLIST_API_SECRET=your_coinlist_api_secret
COINLIST_BASE_URL=https://trade-api.coinlist.co

# Stripe secret key (required if FIAT_GATEWAY_PROVIDER=stripe)
# Format: sk_live_... or sk_test_...
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Wise API key (required if FIAT_GATEWAY_PROVIDER=wise)
WISE_API_KEY=your_wise_api_key_here

# ------------------------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------------------------
# Enable rate locking for conversions
ENABLE_RATE_LOCKING=true

# Enable webhook dispatching
ENABLE_WEBHOOKS=true

# Enable Fragment integration
FRAGMENT_ENABLED=false

# Fragment API URL
FRAGMENT_API_URL=https://fragment.com/api

# ------------------------------------------------------------------------------
# BACKGROUND WORKERS
# ------------------------------------------------------------------------------
# Deposit poll interval (milliseconds)
DEPOSIT_POLL_INTERVAL_MS=30000

# Settlement batch size
SETTLEMENT_BATCH_SIZE=25

# Settlement processing interval (milliseconds)
SETTLEMENT_INTERVAL_MS=60000

# Settlement TON/USD rate
SETTLEMENT_TON_USD_RATE=5.5

# ------------------------------------------------------------------------------
# BATCH CONVERSION
# ------------------------------------------------------------------------------
# Minimum Stars amount for batch conversion
BATCH_CONVERSION_MIN_STARS=1000

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# EMAIL / SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# SMTP server host (required for email-based authentication)
EMAIL_SMTP_HOST=smtp.example.com

# SMTP server port (587 for TLS, 465 for SSL, 25 for non-secure)
EMAIL_SMTP_PORT=587

# Use SSL/TLS for SMTP
EMAIL_SMTP_SECURE=false

# SMTP authentication username (optional)
EMAIL_SMTP_USER=your_smtp_username

# SMTP authentication password (optional)
EMAIL_SMTP_PASS=your_smtp_password

# From email address for sent emails
EMAIL_FROM=no-reply@yourdomain.com

# ------------------------------------------------------------------------------
# DASHBOARD CONFIGURATION
# ------------------------------------------------------------------------------
# Dashboard URL (used for magic links and redirects)
DASHBOARD_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# AWS KMS (Optional)
# ------------------------------------------------------------------------------
# AWS KMS key ID for secret management
AWS_KMS_KEY_ID=your_aws_kms_key_id_here

# AWS region
AWS_REGION=us-east-1

# Alternative: AWS default region
AWS_DEFAULT_REGION=us-east-1

# ------------------------------------------------------------------------------
# TESTING
# ------------------------------------------------------------------------------
# Use Testcontainers for integration tests
USE_TESTCONTAINERS=false

# MailHog API URL for email testing
MAILHOG_API_URL=http://localhost:8025/api/v2/messages
