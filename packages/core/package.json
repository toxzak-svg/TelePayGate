    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.4",
    "pg-promise": "^12.3.0",
