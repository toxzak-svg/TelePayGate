# ==============================================================================
# TELEPAYGATE API - ENVIRONMENT CONFIGURATION
# ==============================================================================
# 
# This file contains environment variables specific to the API package.
# The API package loads environment variables from the project root .env file.
# Copy this file to `.env` at the project root and fill in real values.
#
# SECURITY REQUIREMENTS:
# - NEVER commit actual .env files with real credentials to version control
# - Use strong, unique secrets for all sensitive values
# - Rotate secrets regularly in production environments
# - Use different values for development, staging, and production
#
# GENERATING SECURE VALUES:
# - JWT_SECRET: openssl rand -base64 32 (min 32 characters required)
# - API_SECRET_KEY: openssl rand -base64 32
# - WEBHOOK_SECRET: openssl rand -base64 32
#
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER / RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Node.js environment (development, test, production)
NODE_ENV=development

# Server port for the API
PORT=3000

# Public API URL (used for webhooks, callbacks, and CORS)
API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://tg_user:your_database_password_here@localhost:5432/telepaygate_dev

# Alternative: Individual database connection parameters
# Used by packages/api/src/config/database.ts
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telegram_payment_gateway
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Database connection timeouts (milliseconds)
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Database SSL configuration
# Set to 'true' to enable SSL connections (recommended for production)
DB_SSL=false

# SSL certificate validation
# SECURITY: Set to 'true' ONLY for local development with self-signed certificates
# In production, this should always be 'false' to ensure proper SSL validation
DB_SSL_ALLOW_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# SECURITY / SECRETS
# ------------------------------------------------------------------------------
# API secret key for internal operations
# Generate with: openssl rand -base64 32
API_SECRET_KEY=your_api_secret_key_minimum_32_characters_here

# JWT signing secret
# CRITICAL: MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# Webhook secret for signature verification
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET=your_webhook_secret_minimum_32_characters_here

# ------------------------------------------------------------------------------
# CAPTCHA CONFIGURATION
# ------------------------------------------------------------------------------
# Enable CAPTCHA for registration and sensitive operations
CAPTCHA_ENABLED=false

# CAPTCHA provider (hcaptcha, recaptcha, turnstile)
CAPTCHA_PROVIDER=hcaptcha

# CAPTCHA secret key
CAPTCHA_SECRET=your_captcha_secret_here

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
# Register route rate limiting window (milliseconds)
REGISTER_RATE_LIMIT_WINDOW_MS=3600000

# Maximum registration requests per window
REGISTER_RATE_LIMIT_MAX=10

# ------------------------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------------------------
# Enable passwordless authentication
FEATURE_PASSWORDLESS_AUTH=true

# Expose test tokens in responses (testing only)
EXPOSE_TEST_TOKENS=false

# ------------------------------------------------------------------------------
# TESTING
# ------------------------------------------------------------------------------
# Use Testcontainers for integration tests
USE_TESTCONTAINERS=false

# MailHog API URL for email testing
MAILHOG_API_URL=http://localhost:8025/api/v2/messages

# ------------------------------------------------------------------------------
# TELEGRAM BOT CONFIGURATION
# ------------------------------------------------------------------------------
# Telegram Bot API token (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram webhook secret for verifying incoming webhooks
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# ------------------------------------------------------------------------------
# CONVERSION SETTINGS
# ------------------------------------------------------------------------------
# Minimum Telegram Stars amount for conversion
MIN_CONVERSION_STARS=100

# ------------------------------------------------------------------------------
# EMAIL / SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# SMTP server host (required for email-based authentication)
EMAIL_SMTP_HOST=smtp.example.com

# SMTP server port (587 for TLS, 465 for SSL, 25 for non-secure)
EMAIL_SMTP_PORT=587

# Use SSL/TLS for SMTP
EMAIL_SMTP_SECURE=false

# SMTP authentication username (optional)
EMAIL_SMTP_USER=your_smtp_username

# SMTP authentication password (optional)
EMAIL_SMTP_PASS=your_smtp_password

# From email address for sent emails
EMAIL_FROM=no-reply@yourdomain.com

# ------------------------------------------------------------------------------
# DASHBOARD CONFIGURATION
# ------------------------------------------------------------------------------
# Dashboard URL (used for magic links and redirects)
DASHBOARD_URL=http://localhost:5173
