# ==============================================================================
# TELEPAYGATE DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================
# 
# This file contains environment variables specific to the Dashboard package.
# The Dashboard is a Next.js application that communicates with the API.
# Copy this file to `.env.local` and fill in real values before running.
#
# SECURITY REQUIREMENTS:
# - NEVER commit actual .env files with real credentials to version control
# - Use different values for development, staging, and production
# - Dashboard environment variables are client-side accessible (NEXT_PUBLIC_*)
#
# ==============================================================================

# ------------------------------------------------------------------------------
# API CONFIGURATION
# ------------------------------------------------------------------------------
# Public API URL for TelePayGate API (client-side accessible)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Public application URL for the dashboard (client-side accessible)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# MONITORING (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for error tracking (client-side accessible)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Analytics ID for tracking (client-side accessible)
# NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# ------------------------------------------------------------------------------
# Enable experimental features (client-side accessible)
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# Enable debug mode (client-side accessible)
# NEXT_PUBLIC_DEBUG_MODE=false
