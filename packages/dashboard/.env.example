# TelePayGate Dashboard Environment Variables
# Copy to .env.local for local development

# =============================================================================
# API Configuration
# =============================================================================

# Local development (default)
VITE_API_URL=http://localhost:3000/api/v1

# Production (set in Render dashboard)
# VITE_API_URL=https://telegram-payment-api.onrender.com/api/v1

# =============================================================================
# Feature Flags (Optional)
# =============================================================================

# Enable passwordless authentication (magic link login)
VITE_FEATURE_PASSWORDLESS_AUTH=false

# =============================================================================
# WebSocket Configuration (Future Use)
# =============================================================================
# VITE_WS_URL=ws://localhost:3000
