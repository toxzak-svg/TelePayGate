# Render environment file for blueprint deploy
# Replace all placeholders before deploying (secrets must be provided)

# Runtime
NODE_ENV=production
PORT=10000

# TON / DEX / Conversion (copied from render.yaml defaults)
TON_API_URL=https://toncenter.com/api/v2/jsonRPC
TON_MAINNET=true
TON_WORKCHAIN=0

DEDUST_API_URL=https://api.dedust.io
STONFI_API_URL=https://api.ston.fi
DEX_SLIPPAGE_TOLERANCE=0.5

MIN_CONVERSION_STARS=100
RATE_LOCK_DURATION_SECONDS=300
MAX_PENDING_CONVERSIONS=10
P2P_POOL_REFRESH_INTERVAL=30

DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------
# REQUIRED SECRETS
# ------------------
# Set the platform TON wallet address (EQ... or UQ...)
PLATFORM_TON_WALLET=

# TON wallet mnemonic (24 words)
TON_WALLET_MNEMONIC="REPLACE_WITH_24_WORDS"
TON_API_KEY=REPLACE_TON_API_KEY

# Telegram bot
TELEGRAM_BOT_TOKEN=REPLACE_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_TELEGRAM_WEBHOOK_SECRET

# Security keys
API_SECRET_KEY=REPLACE_API_SECRET_KEY
JWT_SECRET=REPLACE_JWT_SECRET
WALLET_ENCRYPTION_KEY=REPLACE_32_BYTE_HEX_KEY

# Optional exchange rate / fiat connectors (fill if used)
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
COINLIST_API_KEY=
COINLIST_API_SECRET=

# Note: Do NOT include your Render CLI API key here. Provide it as
# an environment variable named RENDER_API_KEY when running the deploy.
