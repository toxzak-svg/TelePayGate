API_SECRET_KEY=REPLACE_WITH_OPENSSL_HEX_32
JWT_SECRET=REPLACE_WITH_OPENSSL_HEX_32
WALLET_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_HEX_32

# Optional
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
