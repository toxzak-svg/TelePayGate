# Example env file for Render blueprint deployment
# Rename to .env.render and fill values before running:

TON_WALLET_MNEMONIC="word1 word2 word3 ... word24"
TON_API_KEY=YOUR_TON_API_KEY
PLATFORM_TON_WALLET=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

