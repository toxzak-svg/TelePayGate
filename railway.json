{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --workspaces --include-workspace-root && npm run build:railway",
    "watchPatterns": [
      "/package.json",
      "/packages/api/**",
      "/packages/core/**",
      "/packages/sdk/**",
      "/packages/dashboard/**",
      "/database/**",
      "/src/trigger/**",
      "/trigger.config.ts"
    ]
  },
  "deploy": {
    "startCommand": "node packages/api/dist/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 90,
    "restartPolicyType": "always"
  },
  "environments": {
    "production": {
      "build": {
        "buildCommand": "npm ci --workspaces --include-workspace-root && npm run build:railway"
      },
      "deploy": {
        "startCommand": "node database/migrate.cjs up && node packages/api/dist/index.js",
        "healthcheckPath": "/health",
        "restartPolicyType": "always"
      }
    },
    "development": {
      "build": {
        "buildCommand": "npm ci --workspaces --include-workspace-root && npm run build:backend"
      },
      "deploy": {
        "startCommand": "node database/migrate.cjs up && node packages/api/dist/index.js",
        "healthcheckPath": "/health",
        "restartPolicyType": "never"
      }
    }
  }
}
