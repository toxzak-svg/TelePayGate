; Speed up installs and reduce noise in CI/local
audit=false
fund=false
progress=false

; Note: --prefer-offline can be useful when caches are present, but may reduce reliability
; prefer-offline=true
# NPM Performance & Space Optimization
# Faster installs and reduced disk usage

# Use lockfile for faster, deterministic installs
package-lock=true

# Reduce network requests
prefer-offline=true
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Optimize package storage
# NOTE: `cache-min` is deprecated. Prefer `--prefer-offline` or
# `prefer-offline=true` in CI/local when safe. See npm docs.
prefer-dedupe=true

# Skip unnecessary scripts for faster installs
ignore-scripts=false

# Production optimizations
audit=false
fund=false
update-notifier=false

# Workspace optimizations
# NOTE: `workspace-concurrency` project config is deprecated and will stop
# working in the next major npm release. Control concurrency via the CLI (for
# example `npm --workspace-concurrency=<n>` when supported) or CI runner parallelism.
